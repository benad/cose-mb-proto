{
  "tasks": {
    "start": "deno run --allow-read --allow-write main.ts",
    "check": "deno check main.ts main_test.ts && deno lint && deno fmt --check",
    "test": "deno test --allow-read --allow-write --allow-run=deno main_test.ts"
  },
  "imports": {
    "webcrypto": "node:crypto",
    "cbor": "npm:cbor@10.0.12"
  },
  "fmt": {
    "exclude": ["Encryption Process.md"],
    "proseWrap": "preserve"
  }
}
